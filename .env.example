# Скопировать в .env и заполнить значения. НЕ коммитить .env!
API_KEY=replace_with_strong_random_api_key
INTEGRAM_LOGIN=your_integram_login
INTEGRAM_PASSWORD=your_integram_password
INTEGRAM_WORKSPACE=beecrm
INTEGRAM_T_EVENTS=37
CORS_ORIGINS=http://178.253.39.215:8080,http://localhost:5277,http://localhost:5173

# ── BEEBOTLITE (apiary module) ────────────────────────────────────────────────
BEEBOTLITE_TOKEN=replace_with_telegram_bot_token
GROQ_API_KEY=replace_with_groq_api_key
BEEBOTLITE_ADMIN_TG_ID=replace_with_admin_telegram_id

# TypeId таблиц пасеки — заполнить после: python -m apiary.scripts.create_tables
APIARY_T_ROLES=0
APIARY_T_HEALTH=0
APIARY_T_HIVES=0
APIARY_T_USERS=0
APIARY_T_INSPECTIONS=0

# Col IDs Ульи
APIARY_COL_HIVE_LOCATION=0
APIARY_COL_HIVE_NOTES=0
APIARY_COL_HIVE_ACTIVE=0

# Col IDs Пользователи бота
APIARY_COL_USER_TG_ID=0
APIARY_COL_USER_USERNAME=0
APIARY_COL_USER_ROLE=0
APIARY_COL_USER_ACTIVE=0

# ── UDS интеграция (polling) ───────────────────────────────────────────────────
UDS_ADMIN_TOKEN=          # Bearer токен, живёт ~120 дней
UDS_COMPANY_ID=549756192009
UDS_POLL_INTERVAL=60      # секунды между опросами
UDS_INITIAL_SYNC=false    # true = загрузить все исторические заказы при старте

# Col IDs Осмотры
APIARY_COL_INSP_HIVE_ID=0
APIARY_COL_INSP_DATE=0
APIARY_COL_INSP_INSPECTOR_TG_ID=0
APIARY_COL_INSP_QUEEN_SEEN=0
APIARY_COL_INSP_BROOD_STATUS=0
APIARY_COL_INSP_HONEY_AMOUNT=0
APIARY_COL_INSP_HEALTH_STATUS=0
APIARY_COL_INSP_ACTIONS_TAKEN=0
APIARY_COL_INSP_NOTES=0
APIARY_COL_INSP_NEEDS_ATTENTION=0
APIARY_COL_INSP_IS_DRAFT=0
APIARY_COL_INSP_SESSION_ID=0
APIARY_COL_INSP_RAW_TEXT=0
